generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inscription {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String
  telephone String
  formation String
  message   String?
  createdAt DateTime @default(now())
}